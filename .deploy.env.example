# Copy to .deploy.env (gitignored) and fill in. Used by deploy.sh.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_BRANCH=main
# Absolute path of the git clone on the server. The scanin.ca document root must be $DEPLOY_PATH/public
DEPLOY_PATH=/home/USER/scanin
# cPanel MultiPHP binary, e.g. /opt/cpanel/ea-php82/root/usr/bin/php (must be PHP 8.2+)
PHP_BIN=/opt/cpanel/ea-php82/root/usr/bin/php
# How to run composer on the server, e.g. "composer" or "/opt/cpanel/ea-php82/root/usr/bin/php /home/USER/composer.phar" (absolute paths only)
COMPOSER_CMD=composer
HEALTH_URL=https://scanin.ca/login
